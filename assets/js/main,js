const headerscroll=document.querySelector("[data-scroll]");
const datasection =document.querySelector("[data-section]");
window.addEventListener('scroll',()=>{
    if (window.scrollY >= datasection.offsetTop)
    {headerscroll.setAttribute('data-scroll'," ")}
    else {headerscroll.removeAttribute('data-scroll')}
})
const menuToggle= document.querySelector("[ data-menu-toggle]")
const nav= document.querySelector("[  data-nav]")

 menuToggle.addEventListener("click",() => {
    
nav.toggleAttribute('data-open');
    
 })